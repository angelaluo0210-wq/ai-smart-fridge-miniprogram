.recipe-hero { margin: 16rpx 0 38rpx; padding: 34rpx; color: #fff; background: linear-gradient(135deg, #247a52, #3e956c); border-radius: 24rpx; }
.recipe-name { font-size: 46rpx; font-weight: 750; }
.recipe-reason { margin-top: 14rpx; font-size: 29rpx; line-height: 1.65; opacity: .92; }
.time-badge { display: inline-block; margin-top: 22rpx; padding: 8rpx 16rpx; font-size: 26rpx; background: rgba(255,255,255,.18); border-radius: 999rpx; }
.ingredient-row { display: flex; justify-content: space-between; min-height: 70rpx; align-items: center; border-bottom: 2rpx solid #edf2ee; }
.ingredient-row:last-child { border-bottom: 0; }
.additional-card { border-left: 10rpx solid #efb642; }
.steps-card { padding-top: 12rpx; padding-bottom: 12rpx; }
.step-row { display: flex; gap: 20rpx; padding: 18rpx 0; border-bottom: 2rpx solid #edf2ee; }
.step-row:last-child { border-bottom: 0; }
.step-number { display: inline-flex; align-items: center; justify-content: center; width: 46rpx; height: 46rpx; flex: none; color: #fff; font-size: 25rpx; background: #247a52; border-radius: 50%; }
.step-text { flex: 1; line-height: 1.65; }
.safety-note { padding: 4rpx 12rpx 34rpx; color: #7b8780; font-size: 25rpx; line-height: 1.65; }
.cook-btn { margin-bottom: calc(28rpx + env(safe-area-inset-bottom)); }
.modal-mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 20; display: flex; align-items: flex-end; background: rgba(17, 31, 23, .48); }
.consume-modal { width: 100%; box-sizing: border-box; padding: 34rpx 28rpx calc(28rpx + env(safe-area-inset-bottom)); background: #f6faf7; border-radius: 28rpx 28rpx 0 0; }
.modal-title { font-size: 40rpx; font-weight: 700; }
.modal-tip { margin-top: 10rpx; color: #66716a; font-size: 27rpx; line-height: 1.6; }
.consume-list { max-height: 58vh; margin: 24rpx 0; }
.consume-row { margin-bottom: 18rpx; padding: 24rpx; background: #fff; border-radius: 18rpx; }
.consume-name { margin-bottom: 16rpx; font-size: 32rpx; font-weight: 650; }
.consume-inputs { display: flex; gap: 14rpx; }
.consume-input, .consume-unit { box-sizing: border-box; min-height: 76rpx; padding: 18rpx; border: 2rpx solid #dbe6df; border-radius: 14rpx; background: #fbfdfb; }
.consume-input { flex: 1; }
.consume-unit { width: 190rpx; }
.stock-line, .shortage-line, .warning-line { margin-top: 12rpx; font-size: 26rpx; }
.stock-line { color: #66716a; }
.shortage-line, .warning-line { color: #a13b2e; }
.modal-actions { display: flex; gap: 18rpx; }
.modal-actions button { flex: 1; margin: 0; }
