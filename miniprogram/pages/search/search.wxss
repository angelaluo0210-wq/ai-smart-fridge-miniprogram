.search-box { display: flex; align-items: center; margin-bottom: 28rpx; padding: 8rpx 22rpx; background: #fff; border: 2rpx solid #b9d3c3; border-radius: 18rpx; }
.search-input { flex: 1; min-height: 76rpx; font-size: 32rpx; }
.clear { padding: 18rpx; color: #247a52; font-size: 28rpx; }
.result-count { margin-bottom: 18rpx; color: #66716a; font-size: 28rpx; }
.result-main { flex: 1; min-width: 0; }
.result-status { display: flex; flex-direction: column; align-items: flex-end; gap: 12rpx; }
.remaining-text { color: #66716a; font-size: 26rpx; }
.clear-expired-btn { margin: 0 0 24rpx; }
